# Supabase — Project URL ve anahtarlar (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL (geliştirmede localhost, üretimde domain)
# Üretim: https://ciftlik.saractavukculuk.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Smoke test için (opsiyonel — yoksa e2e smoke testi atlanır)
# Supabase'de oluşturduğun bir test kullanıcısının bilgileri
# TEST_USER_EMAIL=test@saractavukculuk.com
# TEST_USER_PASSWORD=...

# Telegram günlük ödeme bildirimi (Vercel cron → /api/cron/yaklasan-odemeler)
# Bot @BotFather'dan, chat ID @userinfobot'tan alınır.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel cron Bearer secret (rastgele 32+ karakter; üretimde zorunlu, geliştirmede boş bırakılırsa auth atlanır)
# Üretim için: openssl rand -base64 32
CRON_SECRET=
